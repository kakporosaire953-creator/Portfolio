# ── Contact form ────────────────────────────────────────────────────────────
# Option A — Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="THE KRAFTER <site@votre-domaine.com>"

# Option B — any JSON webhook (Zapier, Make, Formspree, Cloudflare Worker…)
CONTACT_WEBHOOK_URL=

# ── Assistant ───────────────────────────────────────────────────────────────
# Endpoint contract: POST { message, locale } → { reply, links? }
ASSISTANT_API_URL=
ASSISTANT_API_KEY=
# Uncomment once the endpoint above is live:
# NEXT_PUBLIC_ASSISTANT_ENDPOINT=/api/assistant
